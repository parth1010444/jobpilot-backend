# Copy to .env and adjust for your machine. Do not commit real secrets.

# Application
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local

# PostgreSQL (matches docker-compose.yml defaults)
POSTGRES_DB=jobpilot
POSTGRES_USER=jobpilot
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5432

# Spring datasource (host machine talking to published Postgres port)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/jobpilot
SPRING_DATASOURCE_USERNAME=jobpilot
SPRING_DATASOURCE_PASSWORD=changeme

# JWT (Phase 2) — generate a long random secret for any non-local environment
# Example: openssl rand -base64 48
JOBPILOT_JWT_SECRET=replace-me-with-a-long-random-secret
JOBPILOT_JWT_EXPIRATION_MS=86400000

# Phase 8 reminders scheduler
JOBPILOT_REMINDERS_SCHEDULER_ENABLED=true
JOBPILOT_REMINDERS_SCHEDULER_FIXED_DELAY_MS=60000

# Kafka (Phase 9) — docker compose kafka publishes localhost:9092
KAFKA_PORT=9092
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
JOBPILOT_OUTBOX_APPLICATION_EVENTS_TOPIC=jobpilot.application.events
JOBPILOT_OUTBOX_RELAY_ENABLED=true
JOBPILOT_OUTBOX_RELAY_FIXED_DELAY_MS=5000
JOBPILOT_OUTBOX_RELAY_BATCH_SIZE=50
JOBPILOT_OUTBOX_RELAY_MAX_ATTEMPTS=5
JOBPILOT_KAFKA_CONSUMER_ENABLED=true
JOBPILOT_KAFKA_CONSUMER_GROUP_ID=jobpilot-backend

# Redis (Phase 10) — docker compose redis publishes localhost:6379
REDIS_PORT=6379
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=
JOBPILOT_REDIS_ENABLED=true

# Cache TTLs (used when Redis is the cache store)
JOBPILOT_CACHE_RECOMMENDATIONS_TTL=120s
JOBPILOT_CACHE_APPLICATION_MATCH_TTL=180s
JOBPILOT_CACHE_ANALYTICS_TTL=60s

# Rate limiting (Phase 10)
JOBPILOT_RATE_LIMIT_ENABLED=true
JOBPILOT_RATE_LIMIT_DEFAULT=100
JOBPILOT_RATE_LIMIT_AUTH=10
JOBPILOT_RATE_LIMIT_WINDOW=1m

# CORS (Phase 13) — comma-separated browser origins (Vite defaults)
JOBPILOT_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# OpenAPI / Swagger (Phase 13) — disable in production (prod profile forces off)
JOBPILOT_OPENAPI_ENABLED=true

